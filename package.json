{
  "name": "python-coding-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"frontend,worker\" -c \"cyan,yellow\" \"vite\" \"wrangler dev\"",
    "deploy": "npm run build && wrangler deploy",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute python-coding-lab-db --file=worker/db/schema.sql",
    "db:seed": "wrangler d1 execute python-coding-lab-db --file=worker/db/seed.sql"
  },
  "dependencies": {
    "@cloudflare/kv-asset-handler": "^0.4.2",
    "@monaco-editor/react": "^4.6.0",
    "hono": "^4.4.0",
    "jose": "^5.6.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.26.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240924.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "vite": "^5.4.8",
    "wrangler": "^3.78.0"
  }
}
